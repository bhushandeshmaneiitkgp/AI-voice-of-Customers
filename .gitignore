# ---- Secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Testing / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Derived data: reproducible from raw via the pipeline ----
# Raw data IS committed (it is the immutable input, ~1.9MB).
# data/eval/ is deliberately NOT here: once a person fills in gold_labels.csv it
# is the one artefact in this repo that no amount of compute can regenerate.
data/interim/
data/processed/
!data/**/.gitkeep

# ---- Large / regenerable artifacts (FAISS index, LLM response cache) ----
artifacts/
!artifacts/.gitkeep

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
.idea/
*.swp
