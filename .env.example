# =============================================================================
# Copy this file to .env and fill in real values.  .env is gitignored.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / macOS   :  cp .env.example .env
# NEVER commit .env or paste a real key into any tracked file.
# =============================================================================

# --- Secrets -----------------------------------------------------------------
# You only need a key for the provider your selected model uses.
# Phases 1 and 2 (cleaning, taxonomy, EDA) run with NO key at all.

# OpenRouter — the default. One key reaches Llama, Qwen, DeepSeek, gpt-oss and
# more, including free-tier models.  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic — optional, retained as the frontier control arm for the model
# benchmark in EVALUATION.md.  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Any other OpenAI-compatible provider (Groq, Together, Fireworks, DeepSeek
# direct). Point a model's base_url at it in config/models.yaml and put the key
# here. Local servers (Ollama, vLLM) need no key.
LLM_API_KEY=

# --- Model selection (Decision 1: configurable, not hardcoded) ---------------
# Keys must exist in config/models.yaml. Change these to benchmark models
# against the gold evaluation set without touching a single line of code.
#
#   OpenRouter (open weights, ~10x cheaper):
#     llama70b  -> meta-llama/llama-3.3-70b-instruct   (default)
#     qwen72b   -> qwen/qwen-2.5-72b-instruct
#     deepseek  -> deepseek/deepseek-chat
#     gptoss    -> openai/gpt-oss-120b
#   Anthropic (frontier control arm):
#     opus / sonnet / haiku
#   Local:
#     ollama    -> free, offline, needs a GPU
#
# ENRICHMENT = the per-review classification pass (4,620 reviews)
# SYNTHESIS  = low-volume reasoning nodes (opportunities, root cause, brief)
VOC_ENRICHMENT_MODEL=llama70b
VOC_SYNTHESIS_MODEL=opus

# Effort override for models that support it (Anthropic only). Thinking tokens
# bill as output and dominate cost at high effort. Leave blank to use the
# model's registry default. Ignored by models without an effort parameter.
VOC_ENRICHMENT_EFFORT=

# Use the Batch API where the provider offers one (Anthropic only, 50% cheaper).
# Providers without a batch endpoint fall back to concurrent live requests.
VOC_USE_BATCH_API=true

# --- Pipeline behaviour ------------------------------------------------------
# Cosine-similarity threshold for near-duplicate review detection (0.0-1.0).
# Raise to catch fewer duplicates, lower to catch more.
VOC_NEAR_DUP_THRESHOLD=0.80

# Reviews at/near this character length were truncated by the source scraper.
# Empirically observed: a hard pile-up at exactly 500 chars in the raw data.
VOC_TRUNCATION_CAP_CHARS=500
VOC_TRUNCATION_TOLERANCE=5

# Set to a positive integer to process only the first N reviews (fast dev loop).
# Leave blank or 0 to process the full dataset.
VOC_SAMPLE_LIMIT=0

# --- Logging -----------------------------------------------------------------
VOC_LOG_LEVEL=INFO
